Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 40
      Cell Size: 5
    - Class: rviz_default_plugins/PointCloud2
      Name: Lidar
      Enabled: true
      Topic:
        Value: /gabarit/view_cloud
        Reliability Policy: Best Effort
      Size (Pixels): 2
      Style: Points
      Color Transformer: Intensity
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: Obstacle points
      Enabled: false
      Topic:
        Value: /gabarit/obstacle_points
      Size (Pixels): 6
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 40; 40
    - Class: rviz_default_plugins/MarkerArray
      Name: Envelope and obstacles
      Enabled: true
      Topic:
        Value: /gabarit/view_markers
  Global Options:
    Frame Rate: 10
    Fixed Frame: gabarit_view
    Background Color: 12; 16; 22
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 40
      Pitch: 0.35
      Yaw: 3.14
      Focal Point:
        X: 30
        Y: 0
        Z: 0
Window Geometry:
  Width: 1600
  Height: 900
  X: 0
  Y: 0
