#!/usr/bin/env bash
# Gabarit command line inside the container.
set -e
# docker exec does not inherit the environment sourced by PID 1's entrypoint.
source /opt/ros/humble/setup.bash
source /opt/gabarit/ros_ws/install/setup.bash
CFG=${GABARIT_CONFIG:-/opt/gabarit/config/gabarit.yaml}
DATA=${GABARIT_DATA:-/data}
cmd=${1:-detect}; shift || true

case "$cmd" in
  shell)
    exec bash "$@" ;;
  workspace) # persistent detector + RViz; bags controlled in another shell
    exec python3 /opt/gabarit/docker/workspace.py "$@" ;;
  bag)      # list/play/switch/pause/resume/rate/stop/status/log
    exec python3 /opt/gabarit/docker/bag_control.py "$@" ;;
  rviz)
    exec rviz2 -d /opt/gabarit/ros_ws/install/gabarit_ros/share/gabarit_ros/rviz/gabarit.rviz "$@" ;;
  detect)   # ROS 2 node; web UI (live) on :8080
    exec ros2 launch gabarit_ros gabarit.launch.py config:="$CFG" "$@" ;;
  demo)     # persistent node + RViz + initial bag; switch later via gabarit bag
    [ -n "${1:-}" ] || { echo 'usage: gabarit demo BAG [-- ros2 bag play options]' >&2; exit 2; }
    BAG="$1"; shift
    [ "${1:-}" != "--" ] || shift
    exec python3 /opt/gabarit/docker/workspace.py --bag "$BAG" --config "$CFG" -- "$@" ;;
  play)     # only play a bag (use together with `detect` in another container/shell)
    [ -n "${1:-}" ] || { echo 'usage: gabarit play BAG [ros2 bag play options]' >&2; exit 2; }
    BAG=$(python3 -c 'import sys; sys.path.insert(0,"/opt/gabarit/docker"); from bag_control import resolve_bag; from pathlib import Path; print(resolve_bag(sys.argv[1],Path(sys.argv[2])))' "$1" "$DATA"); shift
    exec ros2 bag play "$BAG" "$@" ;;
  web)      # standalone playback UI without ROS on :8000
    exec python3 -m web.server --data "$DATA" --config "$CFG" --host 0.0.0.0 --port 8000 "$@" ;;
  evaluate) # batch evaluation of all bags -> /output
    exec python3 scripts/evaluate.py "$DATA" --config "$CFG" --out /output/eval "$@" ;;
  synthetic) # detection range with synthetic obstacles -> /output
    exec python3 scripts/synthetic_eval.py "$DATA" --config "$CFG" --out /output/synthetic "$@" ;;
  test)
    exec python3 -m pytest -q tests "$@" ;;
  help|--help|-h)
    cat /opt/gabarit/docker/USAGE.txt ;;
  *) exec "$cmd" "$@" ;;
esac
